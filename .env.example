# Этот файл читает ТОЛЬКО docker-compose.yml (для пароля базы данных).
# Скопируйте его в файл с именем ".env" (без .example) и впишите тот
# же пароль, что указан в backend/.env как DB_PASSWORD — пароли в
# этих двух файлах ОБЯЗАТЕЛЬНО должны совпадать, иначе backend не
# сможет подключиться к базе.

DB_PASSWORD=впишите_сюда_тот_же_пароль_что_в_backend/.env
