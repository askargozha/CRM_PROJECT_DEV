# Настройки для ЛОКАЛЬНОЙ разработки. Скопируйте в backend/.env.dev:
#   copy backend\.env.dev.example backend\.env.dev      (Windows)
#   cp backend/.env.dev.example backend/.env.dev        (Mac/Linux)
#
# Здесь нет и не должно быть ключей и паролей боевого сервера.
# Файл .env.dev в git не попадает (.gitignore).

# Подпись токенов входа — для разработки любая строка.
JWT_SECRET_KEY=dev-only-secret-change-me

# ИИ-анализ обращений. Без ключа сайт работает, но анализ (категория,
# оператор, черновик письма) будет падать с понятной ошибкой.
# Свой бесплатный ключ: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Резерв, необязательно: https://console.groq.com/keys
GROQ_API_KEY=

# Шифрование ФИО/телефона. Пусто — хранится без шифрования (для
# разработки нормально).
FIELD_ENCRYPTION_KEY=

# Почта — пусто: письма операторам не отправляются (ошибка видна в
# карточке обращения). Чтобы проверить почту — свой ТЕСТОВЫЙ Gmail и
# его пароль приложения (https://myaccount.google.com/apppasswords);
# письма уйдут на адреса из «Операторов рассылки» в вашей локальной
# базе — впишите туда свою же почту. Боевую почту не вписывать.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# Telegram-бот. Чтобы проверить бота — создайте СВОЕГО тестового бота
# у @BotFather (/newbot), вставьте токен и поставьте true.
# Боевой токен бота сюда не вписывать.
TELEGRAM_BOT_TOKEN=
RUN_BOT_IN_BACKEND=false

# Внешняя CRM (ЕКЦ 109) в разработке всегда выключена.
EXTERNAL_CRM_API_URL=
EXTERNAL_CRM_API_TOKEN=
