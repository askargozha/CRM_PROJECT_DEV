# --- Этап 1: сборка (Node нужен только для этого этапа) ---
FROM node:20-alpine AS build

WORKDIR /app

# Сначала зависимости — Docker закэширует их установку отдельно от
# кода, npm install не будет запускаться заново при каждой правке.
COPY package.json package-lock.json ./

# Та же корпоративная сеть, что резала TLS-цепочку при сборке backend
# (см. комментарий в backend/Dockerfile), точно так же мешает npm
# качать пакеты по HTTPS с реестра — отключаем строгую проверку TLS
# только на этапе сборки образа, сами пакеты не подделываются, просто
# сеть режет сертификат.
RUN npm config set strict-ssl false && npm ci

# Необязательный явный адрес backend — нужен только для туннелей
# (ngrok и т.п.), где у фронтенда и backend разные публичные адреса.
# Если не передать при сборке — используется прежнее автоматическое
# вычисление (тот же хост, порт 8000), ничего не меняется.
ARG VITE_API_URL=""
ENV VITE_API_URL=${VITE_API_URL}

# Копируем весь остальной код и собираем готовые статические файлы.
COPY . .
RUN npm run build

# --- Этап 2: отдача готовых файлов (лёгкий образ, Node тут уже не нужен) ---
FROM nginx:alpine

# Свой конфиг nginx — умеет отдавать React-приложение (важно для
# работы вкладок вроде /tickets/123 при обновлении страницы).
COPY nginx.conf /etc/nginx/conf.d/default.conf

COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
